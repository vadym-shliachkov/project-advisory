{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding returned by an area subagent",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule", "subject", "area", "kind", "title", "why", "severity", "confidence", "evidence", "verified"],
  "properties": {
    "rule": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "area": {
      "type": "string",
      "enum": ["ai-setup", "architecture", "workflow", "hosting", "seo", "content-conversion", "code-quality", "performance", "process-hygiene", "security", "privacy-legal"]
    },
    "kind": { "type": "string", "enum": ["issue", "tooling"] },
    "title": { "type": "string", "minLength": 3 },
    "why": { "type": "string", "minLength": 10 },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": { "type": "string", "enum": ["file", "url", "command", "commit"] },
          "ref": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string" },
          "highRisk": { "type": "boolean" }
        }
      }
    },
    "verified": { "type": "boolean" },
    "toConfirm": { "type": "string", "minLength": 10 },
    "direction": { "type": "string", "minLength": 10 },
    "toolType": { "type": "string", "enum": ["rule", "hook", "skill", "command", "agent", "mcp"] },
    "trigger": { "type": "string", "minLength": 3 },
    "draftDescription": { "type": "string", "minLength": 10 }
  }
}
