{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge-base fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "value", "source", "confidence"],
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-zA-Z0-9-]+)+$" },
    "value": {},
    "source": { "type": "string", "minLength": 1 },
    "sourceHash": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "by": { "type": "string", "minLength": 1 },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "observedAt"],
        "properties": { "value": {}, "observedAt": { "type": "string" } }
      }
    }
  }
}
