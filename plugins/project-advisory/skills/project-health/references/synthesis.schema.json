{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report synthesis: the reader-facing layer written over the ticked findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "decisions", "themes", "wording", "glossary"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "minLength": 40 },
        "strengths": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 5 } }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "findingIds", "problem", "costs", "options", "recommendation"],
        "properties": {
          "id": { "type": "string", "pattern": "^D[1-9]$" },
          "title": { "type": "string", "minLength": 5 },
          "findingIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]+-[0-9a-f]{4,8}$" } },
          "problem": { "type": "string", "minLength": 20 },
          "costs": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 5 } },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description", "pros", "cons", "size", "recommended"],
              "properties": {
                "name": { "type": "string", "minLength": 3 },
                "description": { "type": "string", "minLength": 10 },
                "pros": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 3 } },
                "cons": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 3 } },
                "size": { "type": "string", "enum": ["quick", "small", "medium", "large"] },
                "recommended": { "type": "boolean" }
              }
            }
          },
          "recommendation": { "type": "string", "minLength": 20 }
        }
      }
    },
    "themes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "findingIds", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^T\\d{1,2}$" },
          "title": { "type": "string", "minLength": 5 },
          "findingIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]+-[0-9a-f]{4,8}$" } },
          "summary": { "type": "string", "minLength": 20 }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "today", "proposed"],
      "properties": {
        "summary": { "type": "string", "minLength": 20 },
        "today": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step"],
            "properties": {
              "step": { "type": "string", "minLength": 3 },
              "note": { "type": "string", "minLength": 3 },
              "weak": { "type": "boolean" }
            }
          }
        },
        "proposed": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step"],
            "properties": {
              "step": { "type": "string", "minLength": 3 },
              "note": { "type": "string", "minLength": 3 },
              "toolId": { "type": "string", "pattern": "^[A-Z]+-[0-9a-f]{4,8}$" },
              "tool": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "stages"],
      "properties": {
        "summary": { "type": "string", "minLength": 20 },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "goal", "fixes"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "goal": { "type": "string", "minLength": 10 },
              "fixes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "title", "problem", "approach", "steps", "doneWhen"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^F\\d{1,2}$" },
                    "title": { "type": "string", "minLength": 5 },
                    "covers": { "type": "array", "items": { "type": "string", "pattern": "^(D[1-9]|T\\d{1,2})$" } },
                    "findingIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]+-[0-9a-f]{4,8}$" } },
                    "after": { "type": "array", "items": { "type": "string", "pattern": "^F\\d{1,2}$" } },
                    "problem": { "type": "string", "minLength": 20 },
                    "routes": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "summary", "effort", "pros", "cons"],
                        "properties": {
                          "name": { "type": "string", "minLength": 3 },
                          "summary": { "type": "string", "minLength": 10 },
                          "effort": { "type": "string", "enum": ["quick", "small", "medium", "large"] },
                          "pros": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 3 } },
                          "cons": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 3 } },
                          "compare": {
                            "type": "array",
                            "maxItems": 6,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["row", "value"],
                              "properties": { "row": { "type": "string", "minLength": 2 }, "value": { "type": "string", "minLength": 2 } }
                            }
                          }
                        }
                      }
                    },
                    "choice": { "type": "string", "minLength": 10 },
                    "approach": { "type": "string", "minLength": 20 },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "kind", "title", "what", "effort"],
                        "properties": {
                          "id": { "type": "string", "pattern": "^F\\d{1,2}\\.\\d{1,2}$" },
                          "kind": { "type": "string", "enum": ["check", "work"] },
                          "title": { "type": "string", "minLength": 5 },
                          "what": { "type": "string", "minLength": 10 },
                          "effort": { "type": "string", "enum": ["quick", "small", "medium", "large", "after-check"] },
                          "sizeNote": { "type": "string", "minLength": 10 },
                          "needs": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 5 } },
                          "after": { "type": "array", "items": { "type": "string", "pattern": "^F\\d{1,2}\\.\\d{1,2}$" } },
                          "route": { "type": "string", "minLength": 3 },
                          "checklist": {
                            "type": "array",
                            "maxItems": 15,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["point"],
                              "properties": {
                                "point": { "type": "string", "minLength": 3 },
                                "needs": { "type": "string", "minLength": 2 },
                                "why": { "type": "string", "minLength": 3 }
                              }
                            }
                          }
                        }
                      }
                    },
                    "doneWhen": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 10 } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "trigger", "description", "problem", "benefit", "decision"],
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "type": { "type": "string", "enum": ["rule", "hook", "skill", "command", "agent", "mcp"] },
          "trigger": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 10 },
          "problem": { "type": "string", "minLength": 10 },
          "benefit": { "type": "string", "minLength": 10 },
          "decision": { "type": "string", "pattern": "^D[1-9]$" }
        }
      }
    },
    "wording": { "type": "object" },
    "duplicates": {
      "type": "array",
      "description": "One problem reported by several areas or checks: the report prints and counts it once, as `keep`",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keep", "same"],
        "properties": {
          "keep": { "type": "string", "minLength": 4 },
          "same": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } }
        }
      }
    },
    "glossary": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning"],
        "properties": {
          "term": { "type": "string", "minLength": 2 },
          "meaning": { "type": "string", "minLength": 10 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readable", "notes"],
      "properties": {
        "readable": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    }
  }
}
