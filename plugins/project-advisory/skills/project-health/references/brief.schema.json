{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A participant's brief: what one person of the roadmap decides or does, written for that person",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person",
    "audience",
    "title",
    "intro",
    "items"
  ],
  "properties": {
    "person": {
      "type": "string",
      "minLength": 2
    },
    "audience": {
      "description": "owner: decides and approves, not technical, no time estimates; technical: an outside specialist who agrees an approach; developer: does the work",
      "type": "string",
      "enum": [
        "owner",
        "technical",
        "developer"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "intro": {
      "type": "string",
      "minLength": 20
    },
    "reply": {
      "description": "How to answer: where, and an example answer that uses the item numbers",
      "type": "string",
      "minLength": 10
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "short",
          "summary",
          "need",
          "when",
          "refs",
          "problem",
          "ask",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D\\d{1,2}$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "short": {
            "description": "The title in the table on the first page",
            "type": "string",
            "minLength": 3
          },
          "summary": {
            "description": "The recommendation in a few words, for the first page",
            "type": "string",
            "minLength": 3
          },
          "need": {
            "description": "What the person must answer or do, in a few words",
            "type": "string",
            "minLength": 3
          },
          "when": {
            "type": "string",
            "minLength": 2
          },
          "refs": {
            "description": "The roadmap entries this item covers: solutions, tasks, questions or knowledge notes",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(S\\d{1,3}(\\.\\d{1,2})?|Q\\d{1,3}|K\\d{1,3})$"
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 2
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "neutral",
                    "bad",
                    "warn",
                    "good",
                    "check"
                  ]
                }
              }
            }
          },
          "problem": {
            "type": "string",
            "minLength": 20,
            "description": "Two or three sentences, at most 320 characters: what goes wrong. Detail goes into a block below the cards"
          },
          "ask": {
            "type": "string",
            "minLength": 10,
            "description": "At most 260 characters"
          },
          "recommendation": {
            "type": "string",
            "minLength": 10,
            "description": "At most 280 characters, opening with the answer in bold: **Basic, billed yearly.**"
          },
          "blocks": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "list",
                    "flow",
                    "table",
                    "note",
                    "questions",
                    "groups",
                    "variants",
                    "template",
                    "document",
                    "tasks"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 2,
                  "description": "The small label above the block, saying what it shows (\"The plans\", \"How each logo is decided\"). Required except for note, template and document"
                },
                "text": {
                  "type": "string",
                  "minLength": 3
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warn"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2
                  }
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "text"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 2
                      },
                      "text": {
                        "type": "string",
                        "minLength": 2
                      },
                      "tone": {
                        "type": "string",
                        "enum": [
                          "neutral",
                          "bad",
                          "ask",
                          "good"
                        ]
                      }
                    }
                  }
                },
                "head": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "pick": {
                  "description": "The row to highlight as the recommended one, counted from 0",
                  "type": "integer"
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "question",
                      "why"
                    ],
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Z]$"
                      },
                      "question": {
                        "type": "string",
                        "minLength": 5
                      },
                      "why": {
                        "type": "string",
                        "minLength": 5
                      }
                    }
                  }
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title",
                      "items"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 2
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "note": {
                        "type": "string",
                        "minLength": 3
                      },
                      "first": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "variants": {
                  "description": "Wording options shown as the page shows them: the small line above, the headline and the sentence below; [[+text]] marks what changes",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "heading"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 3
                      },
                      "recommended": {
                        "type": "boolean"
                      },
                      "kicker": {
                        "type": "string",
                        "minLength": 2
                      },
                      "heading": {
                        "type": "string",
                        "minLength": 3
                      },
                      "text": {
                        "type": "string",
                        "minLength": 3
                      },
                      "note": {
                        "type": "string",
                        "minLength": 3
                      }
                    }
                  }
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "heading"
                    ],
                    "properties": {
                      "heading": {
                        "type": "string",
                        "minLength": 2
                      },
                      "paragraphs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 2
                        }
                      },
                      "head": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "rows": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "notes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "for",
                            "text"
                          ],
                          "properties": {
                            "for": {
                              "type": "string",
                              "minLength": 2
                            },
                            "text": {
                              "type": "string",
                              "minLength": 5
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^S\\d{1,3}\\.\\d{1,2}$"
                  }
                }
              }
            }
          },
          "next": {
            "description": "What happens after the person answers or acts",
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "context": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "rows"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "text"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 2
                },
                "text": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          }
        }
      }
    },
    "omit": {
      "description": "The person's roadmap entries deliberately left out of the brief, each with the reason",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "reason"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^S\\d{1,3}(\\.\\d{1,2})?$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "takes": {
      "description": "Tasks the roadmap gives someone else that belong to this reader, each with the reason; the item that covers them names them in refs",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "reason"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^S\\d{1,3}\\.\\d{1,2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
