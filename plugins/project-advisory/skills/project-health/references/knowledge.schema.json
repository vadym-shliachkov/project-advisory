{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project knowledge: the people, key features and ground rules agreed with the people who run the project",
  "type": "object",
  "additionalProperties": false,
  "required": ["people", "notes"],
  "properties": {
    "updatedAt": { "type": "string" },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "availability"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "role": { "type": "string", "minLength": 3 },
          "skills": { "type": "array", "items": { "type": "string", "minLength": 2 } },
          "availability": { "type": "string", "minLength": 3 },
          "notEstimated": { "type": "boolean", "description": "Agreed that this person's tasks carry no time estimate, such as a site owner's decisions and approvals" },
          "audience": { "type": "string", "enum": ["owner", "technical", "developer"], "description": "How this person's brief is written: owner (decides, not technical), technical (an outside specialist who agrees an approach) or developer (does the work)" },
          "notes": { "type": "string", "minLength": 3 }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "detail", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^K\\d{1,3}$" },
          "kind": { "type": "string", "enum": ["feature", "allowed", "forbidden", "convention", "constraint", "decision", "preference"], "description": "preference: something the person liked and asked for more of, saved by a council, venture board, invention lab or design studio session" },
          "title": { "type": "string", "minLength": 5 },
          "detail": { "type": "string", "minLength": 10 },
          "scope": { "type": "string", "minLength": 2 },
          "source": { "type": "string", "enum": ["person", "project"] },
          "findingIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]+-[0-9a-f]{4,8}$" } },
          "by": { "type": "string", "minLength": 2, "description": "The skill that saved the note when it was not the roadmap: council, venture, lab or studio" },
          "ideaIds": { "type": "array", "items": { "type": "string", "pattern": "^I\\d{1,4}$" }, "description": "The ideas in the ledger the person was speaking of when they gave the rule" },
          "addedAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    }
  }
}
