{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An idea in the ledger: a hypothesis for reaching the project's goal, its fate in the council, what the person decided and what happened when it was tried",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "hypothesis", "proposedBy", "status", "history"],
  "properties": {
    "id": { "type": "string", "pattern": "^I\\d{1,4}$" },
    "title": { "type": "string", "minLength": 5 },
    "goal": { "type": "string", "minLength": 5 },
    "proposedBy": { "type": "string", "minLength": 2, "description": "The role that proposed it, such as search or outsider" },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "effect", "because", "killCondition"],
      "properties": {
        "change": { "type": "string", "minLength": 10, "description": "What we do" },
        "effect": { "type": "string", "minLength": 10, "description": "What moves, and by about how much" },
        "because": { "type": "string", "minLength": 10, "description": "The mechanism" },
        "trigger": { "type": "string", "minLength": 10, "description": "What was seen that led to the idea" },
        "killCondition": { "type": "string", "minLength": 10, "description": "The result that would prove it wrong" }
      }
    },
    "parent": { "type": "string", "pattern": "^I\\d{1,4}$", "description": "The idea this one is a narrower form of" },
    "returns": { "type": "string", "pattern": "^I\\d{1,4}$", "description": "An earlier idea, killed or rejected, that this one brings back" },
    "whatChanged": { "type": "string", "minLength": 10, "description": "What is different since the idea it returns as was killed or rejected" },
    "status": { "type": "string", "enum": ["proposed", "killed", "undecided", "survived", "accepted", "rejected", "later", "planned", "testing", "worked", "failed", "inconclusive"] },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": { "type": "string", "enum": ["strong", "fair", "speculative"] },
        "vsDoNothing": { "type": "string", "minLength": 10 },
        "causeOfDeath": { "type": "string", "minLength": 10 },
        "wouldDecide": { "type": "string", "minLength": 10 },
        "session": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "type": "string", "enum": ["accepted", "rejected", "later"] },
        "reason": { "type": "string", "minLength": 5 },
        "date": { "type": "string" }
      }
    },
    "effort": { "type": "string", "enum": ["small", "medium", "large"] },
    "scale": { "type": "string", "enum": ["adjustment", "addition", "direction", "new"], "description": "How far the idea reaches: a change to what is there, something new beside it, a remake of what is there, or something the business does not do or have at all" },
    "novelty": { "type": "string", "enum": ["fresh", "familiar"], "description": "The judge's word at the docket: fresh when it could only come from looking at this project and its market, familiar when any adviser would give it to any firm of this kind" },
    "where": {
      "type": "array",
      "maxItems": 3,
      "description": "The places the idea applies to, so a reader can see them",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "part"],
        "properties": {
          "url": { "type": "string", "pattern": "^https?://" },
          "part": { "type": "string", "minLength": 5, "description": "The part of the page, in plain words" },
          "text": { "type": "string", "minLength": 3, "description": "Words shown in that part, to find it" },
          "selector": { "type": "string", "minLength": 1, "description": "A CSS selector for that part" }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what"],
      "properties": {
        "what": { "type": "string", "minLength": 10, "description": "The cheapest way to find out" },
        "metric": { "type": "string", "minLength": 3 },
        "baseline": { "type": "string", "minLength": 1 },
        "threshold": { "type": "string", "minLength": 1 },
        "checkAfter": { "type": "string", "minLength": 2, "description": "How long after the change to look, such as six weeks" },
        "liveSince": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day the change went live, as the person said it; the wait is counted from it" },
        "checkOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["found"],
      "properties": {
        "found": { "type": "string", "minLength": 10 },
        "source": { "type": "string", "minLength": 2 },
        "date": { "type": "string" }
      }
    },
    "plannedIn": { "type": "string", "minLength": 2, "description": "The roadmap fix plan that adopted it" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event", "by"],
        "properties": {
          "date": { "type": "string" },
          "event": { "type": "string", "minLength": 3 },
          "by": { "type": "string", "minLength": 2 },
          "session": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "addedAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
